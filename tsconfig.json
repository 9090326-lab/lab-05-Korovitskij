{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noImplicitAny": true
  },
  "include": [
    "shared/**/*",
    "server/**/*",
    "client/**/*",
    "src/**/*"
  ]
}